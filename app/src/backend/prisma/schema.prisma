// ═══════════════════════════════════════════════════
// 考评分支机构管理系统 — Prisma 数据库模型
// 数据库：SQLite（起步）→ PostgreSQL（扩展）
// ═══════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// 1. 租户（分支机构）
// ─────────────────────────────────────────────
model Tenant {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  type        TenantType
  status      TenantStatus @default(ACTIVE)
  contactName String?
  contactPhone String?
  address     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users       User[]
  examPlans   ExamPlan[]
  candidates  Candidate[]
  prospectiveCandidates ProspectiveCandidate[]
  auditLogs   AuditLog[]
  workdayCalendar WorkdayCalendar?
  exportTemplates ExportTemplate[]

  @@map("tenants")
}

enum TenantType {
  HQ
  BRANCH
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

// ─────────────────────────────────────────────
// 2. 用户
// ─────────────────────────────────────────────
model User {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  username  String
  password  String     // bcrypt哈希
  realName  String
  role      UserRole
  phone     String?
  email     String?
  status    UserStatus @default(ACTIVE)
  lastLoginAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  auditLogs AuditLog[]
  reminders Reminder[]

  @@unique([tenantId, username])
  @@map("users")
}

enum UserRole {
  SYS_ADMIN
  HQ_ADMIN
  HQ_STAFF
  BRANCH_ADMIN
  BRANCH_STAFF
  EXAMINER
  INSPECTOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

// ─────────────────────────────────────────────
// 3. 考评计划
// ─────────────────────────────────────────────
model ExamPlan {
  id            String     @id @default(uuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  title         String
  occupation    String
  examDate      DateTime
  registrationDeadline DateTime
  profession    String
  level         String
  location      String
  maxCandidates Int        @default(0)
  status        PlanStatus @default(DRAFT)
  notes         String?
  createdBy     String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  nodes       ExamNode[]
  candidates  Candidate[]
  archives    Archive[]
  localUploadBatches LocalUploadBatch[]

  @@map("exam_plans")
}

enum PlanStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
  CANCELLED
}

// ─────────────────────────────────────────────
// 4. 考评节点（核心业务）
// ─────────────────────────────────────────────
model ExamNode {
  id          String     @id @default(uuid())
  planId      String
  plan        ExamPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  nodeType    NodeType
  deadline    DateTime
  completedAt DateTime?
  status      NodeStatus @default(PENDING)
  assignedTo  String?
  notes       String?
  attachments String?    // JSON string array
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  reminders Reminder[]
  auditLogs AuditLog[]

  @@map("exam_nodes")
}

enum NodeType {
  PLAN_CREATE
  REGISTRATION
  ROOM_ARRANGE
  EXAM_PREPARE
  EXAM_DAY
  SCORE_RECORD
  SCORE_PUBLISH
  CERT_MANAGE
  COMPLETE
}

enum NodeStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  SKIPPED
}

// ─────────────────────────────────────────────
// 5. 考生
// ─────────────────────────────────────────────
model Candidate {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  planId      String
  plan        ExamPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  name        String
  idCard      String          // 加密存储
  phone       String?
  gender      String
  education   String?
  workYears   Int?
  photo       String?
  applyLevel  String
  status      CandidateStatus @default(PENDING)
  examRoom    String?
  seatNo      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  score       Score?
  certificate Certificate?
  registrationProfile CandidateRegistrationProfile?
  prospectiveSource ProspectiveCandidate? @relation("ProspectiveConversion")

  @@map("candidates")
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
  EXAMINED
  PASSED
  FAILED
}

// ─────────────────────────────────────────────
// 5.0 意向考生（分支内部线索）
// ─────────────────────────────────────────────
model ProspectiveCandidate {
  id                   String                    @id @default(uuid())
  tenantId             String
  tenant               Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  phone                String
  intendedOccupation   String?
  intendedProfession   String?
  intendedLevel        String?
  source               String?
  status               ProspectiveCandidateStatus @default(FOLLOWING)
  notes                String?
  convertedCandidateId String?                   @unique
  convertedCandidate   Candidate?                @relation("ProspectiveConversion", fields: [convertedCandidateId], references: [id], onDelete: SetNull)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, phone])
  @@map("prospective_candidates")
}

enum ProspectiveCandidateStatus {
  FOLLOWING
  CONVERTED
  NOT_INTERESTED
}

// ─────────────────────────────────────────────
// 5.1 考生报名模板资料（地方系统上传准备）
// ─────────────────────────────────────────────
model CandidateRegistrationProfile {
  id            String        @id @default(uuid())
  candidateId   String        @unique
  candidate     Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fieldsJson    String        @default("{}")
  materialsJson String        @default("{}")
  paymentStatus PaymentStatus @default(UNPAID)
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("candidate_registration_profiles")
}

enum PaymentStatus {
  UNPAID
  PAID
}

// ─────────────────────────────────────────────
// 5.2 地方系统报名上传回填（计划级）
// ─────────────────────────────────────────────
model LocalUploadBatch {
  id         String            @id @default(uuid())
  planId     String
  plan       ExamPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  status     LocalUploadStatus @default(UPLOADED)
  uploadedAt DateTime          @default(now())
  uploadedBy String?
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([planId, uploadedAt])
  @@map("local_upload_batches")
}

enum LocalUploadStatus {
  UPLOADED
}

// ─────────────────────────────────────────────
// 6. 成绩
// ─────────────────────────────────────────────
model Score {
  id            String    @id @default(uuid())
  candidateId   String    @unique
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  theoryScore   Float?
  practiceScore Float?
  comprehensiveScore Float?
  workPerformanceScore Float?
  totalScore    Float?
  theoryAbsent  Boolean   @default(false)
  practiceAbsent Boolean  @default(false)
  comprehensiveAbsent Boolean @default(false)
  workPerformanceAbsent Boolean @default(false)
  isPass        Boolean   @default(false)
  resultStatus  ScoreResultStatus @default(INCOMPLETE)
  source        ScoreSource @default(MANUAL)
  sourceFileName String?
  evaluatedBy   String?
  verifiedBy    String?
  evaluatedAt   DateTime?
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("scores")
}

enum ScoreResultStatus {
  PASS
  FAIL
  INCOMPLETE
}

enum ScoreSource {
  MANUAL
  IMPORT
}

// ─────────────────────────────────────────────
// 7. 证书
// ─────────────────────────────────────────────
model Certificate {
  id          String     @id @default(uuid())
  candidateId String     @unique
  candidate   Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  certNo      String     @unique
  issueDate   DateTime?
  status      CertStatus @default(PENDING)
  issuedBy    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("certificates")
}

enum CertStatus {
  PENDING
  PRINTED
  ISSUED
  REISSUE_REQUESTED
}

// ─────────────────────────────────────────────
// 8. 档案
// ─────────────────────────────────────────────
model Archive {
  id        String        @id @default(uuid())
  planId    String
  plan      ExamPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  filePath  String
  fileSize  Int
  sealHash  String
  status    ArchiveStatus @default(SEALED)
  createdAt DateTime      @default(now())

  @@map("archives")
}

enum ArchiveStatus {
  SEALED
  OPENED
}

// ─────────────────────────────────────────────
// 9. 提醒
// ─────────────────────────────────────────────
model Reminder {
  id          String          @id @default(uuid())
  nodeId      String
  node        ExamNode        @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  type        ReminderType
  content     String
  scheduledAt DateTime
  sentAt      DateTime?
  channel     String          @default("IN_APP")
  status      ReminderStatus  @default(PENDING)
  createdAt   DateTime        @default(now())

  @@map("reminders")
}

enum ReminderType {
  NODE_START
  NODE_DEADLINE
  NODE_OVERDUE
  SYSTEM_NOTICE
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// ─────────────────────────────────────────────
// 10. 审计日志（全操作留痕）
// ─────────────────────────────────────────────
model AuditLog {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  examNodeId String?
  examNode   ExamNode? @relation(fields: [examNodeId], references: [id])
  action     String
  target     String
  targetId   String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// 11. 系统配置（KV存储）
// ─────────────────────────────────────────────
model Config {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("configs")
}

// ─────────────────────────────────────────────
// 12. 分支工作日历（节假日 + 调休）
// ─────────────────────────────────────────────
model WorkdayCalendar {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  holidays  String   @default("[]") // JSON string: yyyy-MM-dd[]
  workdays  String   @default("[]") // JSON string: yyyy-MM-dd[]
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workday_calendars")
}

// ─────────────────────────────────────────────
// 13. 导出模板（分支模板库）
// ─────────────────────────────────────────────
model ExportTemplate {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  type       String
  fileName   String?
  fileBase64 String?
  mappingJson String
  isDefault  Boolean  @default(false)
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, type])
  @@map("export_templates")
}
