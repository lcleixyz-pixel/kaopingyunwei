# ═══════════════════════════════════════════════════
# 考评分支机构管理系统 — 环境变量配置
# 
# 使用说明：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 修改以下配置值（尤其是安全相关的）
#   3. 运行 ./scripts/start.sh
# ═══════════════════════════════════════════════════

# ─── 基础配置 ───
# 本地独占 80 端口时可用 80。
# 云服务器已由宝塔/Nginx 托管 80/443 时，建议改为 127.0.0.1:8080，
# 再由宝塔按域名反向代理到 http://127.0.0.1:8080。
EXAM_PORT=80

# ─── 数据库 ───
DATABASE_URL="file:../../../data/exam.db"

# ─── 安全设置（⚠️ 生产环境必须修改，否则后端会拒绝启动） ───
JWT_SECRET=change-this-jwt-secret-before-production
ENCRYPTION_KEY=change-this-encryption-key-32-chars-minimum

# ─── Docker 生产路径（通常无需修改） ───
BACKUP_DIR=/app/data/backups
LOG_DIR=/app/data/logs

# ─── 备份策略 ───
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_TIME=02:00

# ─── 提醒设置 ───
REMINDER_ENABLED=true

# ─── CORS ───
# 生产环境建议填写公网域名，例如 https://exam.example.com
CORS_ORIGIN=*
