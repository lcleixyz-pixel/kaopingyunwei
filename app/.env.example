# ═══════════════════════════════════════════════════
# 考评分支机构管理系统 — 环境变量配置
# 
# 使用说明：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 修改以下配置值（尤其是安全相关的）
#   3. 运行 ./scripts/start.sh
# ═══════════════════════════════════════════════════

# ─── 基础配置 ───
# 本地独占 80 端口时可用 80。
# 云服务器已由宝塔/Nginx 托管 80/443 时，建议改为 127.0.0.1:8080，
# 再由宝塔按域名反向代理到 http://127.0.0.1:8080。
EXAM_PORT=80

# ─── 数据库 ───
DATABASE_URL="file:../../../data/exam.db"

# ─── 安全设置（⚠️ 生产环境必须修改，否则后端会拒绝启动） ───
JWT_SECRET=change-this-jwt-secret-before-production
ENCRYPTION_KEY=change-this-encryption-key-32-chars-minimum

# 初始化账号密码。生产环境必须填写强密码 JSON；不要把真实值提交到仓库。
# 示例中的值必须替换为受控密码管理器生成的强密码。
# SEED_USER_PASSWORDS_JSON={"admin":"Replace-With-Strong-Secret-1!","hqadmin":"Replace-With-Strong-Secret-2!","hqstaff":"Replace-With-Strong-Secret-3!","bjadmin":"Replace-With-Strong-Secret-4!","bjstaff":"Replace-With-Strong-Secret-5!","szadmin":"Replace-With-Strong-Secret-6!","szstaff":"Replace-With-Strong-Secret-7!","xjadmin":"Replace-With-Strong-Secret-8!","xjstaff":"Replace-With-Strong-Secret-9!","ynadmin":"Replace-With-Strong-Secret-10!","ynstaff":"Replace-With-Strong-Secret-11!"}

# ─── Docker 生产路径（通常无需修改） ───
BACKUP_DIR=/app/data/backups
LOG_DIR=/app/data/logs

# ─── 备份策略 ───
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_TIME=02:00

# ─── 提醒设置 ───
REMINDER_ENABLED=true

# ─── PDF 楷体字体 ───
# 固定模板 PDF 要求中文使用楷体。请指定容器内可用的中文楷体 .ttf/.otf/.ttc 文件路径。
# 若字体为 .ttc 集合，还需要填写字体 face，例如 STKaitiSC-Regular。
# PDF_CHINESE_FONT_PATH=/app/data/fonts/Kaiti.ttc
# PDF_CHINESE_FONT_FACE=STKaitiSC-Regular

# ─── CORS ───
# 生产环境建议填写公网域名，例如 https://exam.example.com
CORS_ORIGIN=*
